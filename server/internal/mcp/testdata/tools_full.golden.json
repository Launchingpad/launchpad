{
  "tools": [
    {
      "name": "get_issue",
      "description": "Get one issue by identifier (ORB-123), id, or imported Linear id. Includes its attachments and its linked merge or pull requests (changeRequests, each with a state: draft, open, approved, merged or closed).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fields": {
            "description": "accepted for Linear compatibility; every field is returned. relations, comments and stateHistory also fetch those",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "issue identifier (ORB-123) or id",
            "type": "string"
          },
          "includeComments": {
            "description": "include the comments",
            "type": "boolean"
          },
          "includeRelations": {
            "description": "include blocks / blockedBy / related / duplicate relations",
            "type": "boolean"
          },
          "includeStateHistory": {
            "description": "include the state change history",
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_issues",
      "description": "List issues, newest first. Filters combine with AND. Descriptions are cut to 400 characters; use get_issue for the full text.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "assignee": {
            "description": "username, display name, `me`, or `none`",
            "type": "string"
          },
          "createdAt": {
            "description": "created on or after: ISO-8601 duration (-P1D) or timestamp",
            "type": "string"
          },
          "cursor": {
            "description": "nextCursor from the previous page",
            "type": "string"
          },
          "cycle": {
            "description": "cycle number, `active`, or cycle id",
            "type": "string"
          },
          "fields": {
            "description": "accepted for Linear compatibility; every field is returned. description returns the full text instead of the first 400 characters",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "includeArchived": {
            "description": "include archived rows (default false)",
            "type": "boolean"
          },
          "label": {
            "description": "label names, comma-separated",
            "type": "string"
          },
          "limit": {
            "description": "page size, 1-250 (default 50; larger values are cut to 250)",
            "type": "integer"
          },
          "orderBy": {
            "description": "sort key, newest first (default updatedAt)",
            "enum": [
              "updatedAt",
              "createdAt"
            ],
            "type": "string"
          },
          "parentId": {
            "description": "parent issue identifier or id",
            "type": "string"
          },
          "priority": {
            "description": "0 none, 1 urgent, 2 high, 3 medium, 4 low",
            "type": "integer"
          },
          "product": {
            "description": "product slug or id: the issues of all its teams (see list_products)",
            "type": "string"
          },
          "project": {
            "description": "project name or id",
            "type": "string"
          },
          "query": {
            "description": "substring of title or description, or a ticket: an identifier (LAUN-113), a bare number (113) or #113",
            "type": "string"
          },
          "state": {
            "description": "state names or ids, comma-separated; a state TYPE (started, unstarted, ...) that is no state's name filters by type, as Linear",
            "type": "string"
          },
          "stateType": {
            "description": "triage, backlog, unstarted, started, completed, canceled (comma-separated)",
            "type": "string"
          },
          "team": {
            "description": "team key, name or id",
            "type": "string"
          },
          "updatedAt": {
            "description": "updated on or after: ISO-8601 duration (-P1D) or timestamp",
            "type": "string"
          }
        },
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "save_issue",
      "description": "Create an issue (no id) or update one (id). On update, absent fields are left alone and null clears. addLabels, blocks, blockedBy, relatedTo and duplicateOf only ever ADD; labels replaces the set.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "addLabels": {
            "description": "label names or ids to add",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "assignee": {
            "description": "username, display name, email or `me`; null unassigns",
            "type": [
              "string",
              "null"
            ]
          },
          "blockedBy": {
            "description": "issues that block this one (append-only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "blocks": {
            "description": "issues this one blocks (append-only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cycle": {
            "description": "cycle number, `active`, or cycle id, in the issue's team",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "description": "markdown; replaces the whole description",
            "type": [
              "string",
              "null"
            ]
          },
          "dueDate": {
            "description": "YYYY-MM-DD",
            "type": [
              "string",
              "null"
            ]
          },
          "duplicateOf": {
            "description": "the issue this one duplicates (append-only)",
            "type": "string"
          },
          "estimate": {
            "description": "points, 0-1000",
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "description": "identifier or id of the issue to update; omit to create",
            "type": "string"
          },
          "labels": {
            "description": "label names or ids; REPLACES the set",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "links": {
            "description": "link attachments to add, e.g. the MR (append-only: a URL already attached is skipped)",
            "items": {
              "additionalProperties": false,
              "properties": {
                "title": {
                  "description": "default: the URL",
                  "type": "string"
                },
                "url": {
                  "description": "absolute http(s) URL",
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "milestone": {
            "description": "milestone name or id, in the issue's project",
            "type": [
              "string",
              "null"
            ]
          },
          "parentId": {
            "description": "parent identifier or id",
            "type": [
              "string",
              "null"
            ]
          },
          "patch": {
            "description": "update only: edit the description in place, in order. append / prepend {text}; insert_before / insert_after {anchor, text}; replace {old_string, new_string}. An anchor or old_string must occur exactly once. Not with description.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "anchor": {
                  "description": "insert_before, insert_after: text that occurs exactly once",
                  "type": "string"
                },
                "from": {
                  "description": "replace_range: start of the range (kept out), occurs exactly once",
                  "type": "string"
                },
                "new_string": {
                  "description": "replace, replace_range",
                  "type": "string"
                },
                "old_string": {
                  "description": "replace: text that occurs exactly once",
                  "type": "string"
                },
                "op": {
                  "enum": [
                    "append",
                    "prepend",
                    "insert_before",
                    "insert_after",
                    "replace",
                    "replace_range"
                  ],
                  "type": "string"
                },
                "replace_all": {
                  "description": "replace: every occurrence (at least one) instead of exactly one",
                  "type": "boolean"
                },
                "text": {
                  "description": "append, prepend, insert_before, insert_after",
                  "type": "string"
                },
                "to": {
                  "description": "replace_range: text after the range (kept), the first occurrence after from",
                  "type": "string"
                }
              },
              "required": [
                "op"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "priority": {
            "description": "0 none, 1 urgent, 2 high, 3 medium, 4 low",
            "type": "integer"
          },
          "project": {
            "description": "project name or id",
            "type": [
              "string",
              "null"
            ]
          },
          "relatedTo": {
            "description": "related issues (append-only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeBlockedBy": {
            "description": "update only: remove these blockedBy relations",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeBlocks": {
            "description": "update only: remove these blocks relations",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeLabels": {
            "description": "label names or ids to remove (update only)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeRelatedTo": {
            "description": "update only: remove these related relations",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "description": "state name or id in the issue's team",
            "type": "string"
          },
          "team": {
            "description": "team key, name or id, create only (default LAUNCHPAD_TEAM)",
            "type": "string"
          },
          "title": {
            "description": "required to create",
            "type": "string"
          },
          "version": {
            "description": "update only: compare-and-swap on the issue version",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
