# Variables for deploy/docker-compose.sample.yml. Copy to
# deploy/sample.env, set every value, chmod 0600. Never commit the copy.
# Guide: docs/self-hosting.md, "Run it from a compose file only".
# Required secrets are EMPTY on purpose: compose refuses to start until you set
# them. Make each one with `openssl rand -hex 32` (a different value each).

# Tag of the LOCAL images you built: launchpad-api:<tag>, launchpad-web:<tag>.
LAUNCHPAD_VERSION='local'

# Your two DNS names (your TLS proxy forwards them to the two ports). The
# stack speaks plain HTTP only; your proxy ends TLS.
WEB_HOST='launchpad.example.com'
FILES_HOST='launchpad-files.example.com'
# Default 127.0.0.1. Read "Set up the reverse proxy" in docs/self-hosting.md
# before you change it. Do not use 0.0.0.0 on a host with a public address.
SAMPLE_BIND_ADDR='127.0.0.1'
SAMPLE_WEB_PORT='4001'
SAMPLE_FILES_PORT='4002'

# Secrets. Empty: set each one (openssl rand -hex 32).
POSTGRES_PASSWORD=''
AUTH_OTP_PEPPER=''
# 64 hex characters. All zeros is refused by the server.
SETTINGS_ENCRYPTION_KEY=''
BACKUP_ENCRYPTION_KEY=''
# silo's root login. The user name is any word; it need not be hex.
SILO_ROOT_USER=''
SILO_ROOT_PASSWORD=''

# The attachment store: a bucket name (3-63 of a-z 0-9 . -) and the app's own
# silo user, made once by the step in the guide. The access key (a user name,
# at least 3 characters) need not be hex; the secret key should be.
S3_BUCKET='launchpad-attachments'
S3_ACCESS_KEY=''
S3_SECRET_KEY=''

# Optional. Empty token: nobody can log in with an email code.
POSTMARK_SERVER_TOKEN=''
POSTMARK_FROM=''
# Optional, empty = off. Comma lists of CIDRs; see deploy/.env.example.
TRUSTED_PROXY_CIDRS=''
GIT_ALLOW_PRIVATE_PROVIDERS=''
GIT_ALLOW_PRIVATE_CIDRS=''
