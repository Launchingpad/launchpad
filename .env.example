# Variables for docker-compose.yml (the root file, not deploy/). Normal use:
# run scripts/gen-env.sh, which copies this file to .env with random secrets
# and your two host names. By hand: cp .env.example .env, chmod 0600 .env, and
# set every empty value. Compose refuses to start while one is empty.
# Guide: docs/self-hosting.md, "Run it from a compose file only".
# Values are single-quoted (dotenv literal). Never commit .env.

# A release version without the v (for example 1.2.3). Required: there is no
# `latest`. Pick one at https://github.com/Launchingpad/launchpad/releases.
LAUNCHPAD_VERSION=''

# Your two DNS names (your TLS proxy forwards them to the two ports below).
# The stack speaks plain HTTP only; your proxy ends TLS. No scheme, no path.
WEB_HOST=''
FILES_HOST=''

# Default 127.0.0.1. Read "Set up the reverse proxy" in docs/self-hosting.md
# before you change it. Do not use 0.0.0.0 on a host with a public address.
LAUNCHPAD_BIND_ADDR='127.0.0.1'
LAUNCHPAD_WEB_PORT='4001'
LAUNCHPAD_FILES_PORT='4002'

# Where the data lives on the host (bind mounts). Relative paths are relative
# to the directory of docker-compose.yml. Each of the three can be set alone.
LAUNCHPAD_DATA_DIR='./data'
# LAUNCHPAD_DB_DIR='./data/postgres'
# LAUNCHPAD_FILES_DIR='./data/files'
# LAUNCHPAD_BACKUP_DIR='./data/backups'

# The nightly dump: time in UTC and days to keep (a whole number, 1 or more).
BACKUP_AT_UTC='03:15'
BACKUP_KEEP_DAYS='30'

# Secrets. scripts/gen-env.sh makes each one (openssl rand -hex 32). Empty here.
POSTGRES_PASSWORD=''
AUTH_OTP_PEPPER=''
# 64 hex characters. All zeros is refused by the server. Keep a copy of .env
# off this host: a lost key makes the stored mail and backup secrets unreadable.
SETTINGS_ENCRYPTION_KEY=''
BACKUP_ENCRYPTION_KEY=''
# silo's root login. The user name is any word; it need not be hex.
SILO_ROOT_USER=''
SILO_ROOT_PASSWORD=''

# The attachment store: a bucket name (3-63 of a-z 0-9 . -) and the app's own
# silo user, which the one-shot silo-init service makes. The access key is a
# user name (at least 3 characters); the secret key is random.
S3_BUCKET='launchpad-attachments'
S3_ACCESS_KEY=''
S3_SECRET_KEY=''

# Optional. Empty token: nobody can log in with an email code until a platform
# admin sets the mail transport in the app.
POSTMARK_SERVER_TOKEN=''
POSTMARK_FROM=''
# Optional, empty = off. Comma lists of CIDRs; see docs/deploy.md.
TRUSTED_PROXY_CIDRS=''
GIT_ALLOW_PRIVATE_PROVIDERS=''
GIT_ALLOW_PRIVATE_CIDRS=''
