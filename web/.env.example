# Production: the API host, no trailing slash. Empty = same origin (dev proxy).
VITE_API_BASE=
# Dev server only: where /api is proxied.
VITE_PROXY_TARGET=http://localhost:18091
# Dev only (ignored by production builds, which also refuse to build with it set):
# a bearer token used instead of the cookie login. Keep it in .env.local.
# VITE_DEV_TOKEN=odt_...
